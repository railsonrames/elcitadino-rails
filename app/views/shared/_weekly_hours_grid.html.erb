<%# locals: availabilities (current ProviderAvailability rows, if any), field_name_prefix (e.g. "service[availability_windows]") %>
<div data-controller="weekly-schedule">
  <div class="flex flex-wrap gap-2 mb-3">
    <button type="button" data-action="weekly-schedule#presetWeekdays"
          class="rounded-full px-3 py-1.5 text-xs font-medium bg-gray-100 hover:bg-gray-200 cursor-pointer">
      <%= t("shared.weekly_hours_grid.presets.weekdays") %>
    </button>
    <button type="button" data-action="weekly-schedule#presetWeekdaysSaturday"
          class="rounded-full px-3 py-1.5 text-xs font-medium bg-gray-100 hover:bg-gray-200 cursor-pointer">
      <%= t("shared.weekly_hours_grid.presets.weekdays_saturday") %>
    </button>
    <button type="button" data-action="weekly-schedule#presetAllWeek"
          class="rounded-full px-3 py-1.5 text-xs font-medium bg-gray-100 hover:bg-gray-200 cursor-pointer">
      <%= t("shared.weekly_hours_grid.presets.all_week") %>
    </button>
    <button type="button" data-action="weekly-schedule#clear"
          class="rounded-full px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 cursor-pointer">
      <%= t("shared.weekly_hours_grid.presets.clear") %>
    </button>
  </div>

  <div class="space-y-2" data-weekly-schedule-target="grid">
    <% (0..6).each do |day_of_week| %>
      <% window = availabilities.find { |a| a.day_of_week == day_of_week } %>
      <div class="flex items-center gap-2" data-day="<%= day_of_week %>">
        <span class="w-24 text-sm text-gray-700 shrink-0"><%= I18n.t("date.day_names")[day_of_week] %></span>
        <%# time_field_tag (the plain _tag helper, unlike form.time_field)
            doesn't format Time/TimeWithZone values for an HTML5 time input
            on its own — it just stringifies whatever it's given, so a raw
            AR time-column value renders as "2000-01-01 09:00:00 UTC" and
            the browser silently discards it as invalid, leaving the field
            blank. Formatting to "HH:MM" explicitly is what makes existing
            hours actually show up when editing. %>
        <%= time_field_tag "#{field_name_prefix}[#{day_of_week}][start_time]", window&.start_time&.strftime("%H:%M"),
              class: "shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-2 py-1.5 text-sm w-full" %>
        <span class="text-gray-400">–</span>
        <%# Triggering on blur (not change) of the END time specifically —
            the picker fires intermediate change events while still being
            adjusted, so triggering on change popped the modal before the
            user had finished picking the end time. %>
        <%= time_field_tag "#{field_name_prefix}[#{day_of_week}][end_time]", window&.end_time&.strftime("%H:%M"),
              class: "shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-2 py-1.5 text-sm w-full",
              data: { action: "blur->weekly-schedule#fieldChanged" } %>
      </div>
    <% end %>
  </div>

  <dialog data-weekly-schedule-target="dialog" class="rounded-2xl p-6 max-w-sm w-[90vw] m-auto backdrop:bg-black/40">
    <h3 class="font-bold text-lg mb-1"><%= t("shared.weekly_hours_grid.repeat_modal.title") %></h3>
    <p class="text-sm text-gray-700 mb-3">
      <%= t("shared.weekly_hours_grid.repeat_modal.help") %> <strong data-weekly-schedule-target="repeatRange"></strong>
    </p>

    <div class="space-y-1 mb-4">
      <% (0..6).each do |day_of_week| %>
        <label class="flex items-center gap-2 text-sm" data-weekly-schedule-target="dayCheckboxWrapper" data-checkbox-day="<%= day_of_week %>">
          <input type="checkbox" checked data-weekly-schedule-target="dayCheckbox" value="<%= day_of_week %>" class="rounded">
          <%= I18n.t("date.day_names")[day_of_week] %>
        </label>
      <% end %>
    </div>

    <div class="flex gap-2 justify-end">
      <button type="button" data-action="weekly-schedule#skip" class="rounded-md px-3.5 py-2 bg-gray-100 hover:bg-gray-200 font-medium cursor-pointer">
        <%= t("shared.weekly_hours_grid.repeat_modal.skip") %>
      </button>
      <button type="button" data-action="weekly-schedule#apply" class="rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer">
        <%= t("shared.weekly_hours_grid.repeat_modal.apply") %>
      </button>
    </div>
  </dialog>
</div>
