<%# locals: form, field, label, helper_text: nil, checkbox_data: {} %>
<% checkbox_data = local_assigns.fetch(:checkbox_data, {}) %>
<label class="flex items-center justify-between gap-4 py-3 cursor-pointer">
  <span>
    <span class="block font-medium"><%= label %></span>
    <% if defined?(helper_text) && helper_text.present? %>
      <span class="block text-sm text-gray-500"><%= helper_text %></span>
    <% end %>
  </span>

  <span class="relative inline-block w-11 h-6 shrink-0">
    <%= form.check_box field, class: "peer sr-only", data: checkbox_data %>
    <span class="block w-11 h-6 bg-gray-300 peer-checked:bg-blue-600 rounded-full transition-colors"></span>
    <span class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-5"></span>
  </span>
</label>
