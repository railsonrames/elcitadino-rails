<details class="relative">
  <summary class="list-none cursor-pointer p-1.5 rounded-full hover:bg-gray-100 [&::-webkit-details-marker]:hidden">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
      <path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
      <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
    </svg>
  </summary>

  <div class="absolute right-0 mt-2 w-64 bg-white border border-gray-200 rounded-xl shadow-lg p-4 z-30">
    <p class="font-medium text-sm mb-1"><%= t("layouts.navbar.notifications") %></p>
    <p class="text-sm text-gray-500"><%= t("layouts.navbar.no_notifications_yet") %></p>
  </div>
</details>
