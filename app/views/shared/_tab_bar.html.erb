<%# Barra de abas inferior do "app shell" (tema azul+gris). Só renderizada quando
    logado (ver app_shell? em ApplicationHelper). Conjunto de abas depende do papel. %>
<%
  icon_search   = "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.35-4.35"
  icon_clock    = "M12 7.5V12l3.5 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z"
  icon_calendar = "M7 3v3M17 3v3M4 8h16M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z"
  icon_people   = "M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8 10a8 8 0 0 0-16 0"
  icon_message  = "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"
  icon_profile  = "M4 6h16M4 12h16M4 18h16"

  is_provider = current_user.provider_profile.present?

  # Reaproveita labels já traduzidas da navbar antiga onde o texto bate exatamente
  # (mesmas 4 línguas já cobertas); só o que é literalmente novo ganha chave nova
  # em shared.tab_bar.*.
  tabs = if is_provider
    [
      { label: t("shared.tab_bar.agenda"), icon: icon_calendar, path: dashboard_path, active: controller_name == "dashboard" },
      { label: t("layouts.navbar.my_appointments"), icon: icon_clock, path: appointments_path, active: controller_name == "appointments" },
      { label: t("shared.tab_bar.clients"), icon: icon_people, path: nil, active: false },
      { label: t("shared.tab_bar.profile"), icon: icon_profile, path: edit_user_registration_path, active: controller_name == "registrations" }
    ]
  else
    [
      { label: t("layouts.navbar.browse_providers"), icon: icon_search, path: providers_path, active: controller_name == "providers" },
      { label: t("shared.tab_bar.my_appointments"), icon: icon_clock, path: appointments_path, active: controller_name == "appointments" },
      { label: t("shared.tab_bar.messages"), icon: icon_message, path: nil, active: false },
      { label: t("shared.tab_bar.profile"), icon: icon_profile, path: edit_user_registration_path, active: controller_name == "registrations" }
    ]
  end
%>
<%# Mobile: fixa na base da viewport (o app É a tela inteira). A partir de lg:,
    vive dentro do cartão emoldurado do layout como um filho flex normal, no
    fundo do cartão — não da janela. %>
<nav class="fixed lg:relative lg:shrink-0 bottom-0 inset-x-0 z-40 grid grid-cols-4 bg-surface border-t border-line pt-2.5 pb-3.5 w-full max-w-[430px] lg:max-w-none mx-auto lg:mx-0">
  <% tabs.each do |tab| %>
    <% classes = "flex flex-col items-center gap-1 #{tab[:active] ? "text-brand" : "text-ink-3"}" %>
    <% if tab[:path] %>
      <%= link_to tab[:path], class: classes do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="21" height="21"><path d="<%= tab[:icon] %>" /></svg>
        <span class="font-bold text-[10px]"><%= tab[:label] %></span>
      <% end %>
    <% else %>
      <span class="<%= classes %> opacity-50" aria-disabled="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="21" height="21"><path d="<%= tab[:icon] %>" /></svg>
        <span class="font-bold text-[10px]"><%= tab[:label] %></span>
      </span>
    <% end %>
  <% end %>
</nav>
