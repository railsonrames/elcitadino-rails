<% content_for :title, t(".title") %>

<div class="w-full max-w-md">
  <%= render "shared/back_link", path: profile_security_path, label: t(".back") %>

  <h1 class="font-bold text-3xl mb-6"><%= t(".title") %></h1>

  <%= form_for(@user, as: :user, url: user_registration_path, html: { method: :put }, class: "contents") do |f| %>
    <% if @user.errors.any? %>
      <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mb-5">
        <ul class="list-disc ml-6">
          <% @user.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="my-5">
      <%= f.label :password, class: "block font-medium mb-1" %>
      <p class="text-sm text-gray-500"><em><%= t("devise.shared.minimum_password_length", count: Devise.password_length.min) %></em></p>
      <%= f.password_field :password, autocomplete: "new-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :password_confirmation, class: "block font-medium mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :current_password, class: "block font-medium mb-1" %>
      <span class="text-sm text-gray-500">(<%= t(".we_need_your_current_password_to_confirm_your_changes") %>)</span>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= f.submit t(".update"), class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
