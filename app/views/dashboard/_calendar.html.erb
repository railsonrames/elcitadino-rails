<div class="border border-gray-200 rounded-2xl p-4 mb-4">
  <div class="flex items-center justify-between mb-3">
    <%= link_to dashboard_path(date: (calendar_month - 1.month).iso8601),
          data: { turbo_frame: "dashboard_panel" }, class: "p-1.5 rounded-full hover:bg-gray-100", "aria-label": t(".previous_month") do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m15 18-6-6 6-6" /></svg>
    <% end %>
    <p class="font-medium capitalize"><%= l(calendar_month, format: "%B %Y") %></p>
    <%= link_to dashboard_path(date: (calendar_month + 1.month).iso8601),
          data: { turbo_frame: "dashboard_panel" }, class: "p-1.5 rounded-full hover:bg-gray-100", "aria-label": t(".next_month") do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m9 18 6-6-6-6" /></svg>
    <% end %>
  </div>

  <div class="grid grid-cols-7 gap-y-1 text-center text-xs text-gray-400 mb-1">
    <% I18n.t("date.abbr_day_names").each do |day_name| %>
      <div><%= day_name %></div>
    <% end %>
  </div>

  <div class="grid grid-cols-7 gap-y-1 text-center text-sm">
    <% calendar_weeks(calendar_month).flatten(1).each do |date, in_month| %>
      <% if in_month %>
        <% blocked = blocked_dates.include?(date) %>
        <% has_appointments = appointment_dates.include?(date) %>
        <% is_selected = date == selected_date %>
        <% cell_classes = if is_selected
             "bg-blue-600 text-white font-bold"
           elsif blocked
             "text-gray-400 line-through hover:bg-gray-100"
           else
             "hover:bg-gray-100"
           end %>
        <%= link_to dashboard_path(date: date.iso8601), data: { turbo_frame: "dashboard_panel" },
              class: "relative mx-auto flex items-center justify-center w-8 h-8 rounded-full #{cell_classes} #{"ring-1 ring-blue-400" if date == Date.current && !is_selected}" do %>
          <%= date.day %>
          <% if has_appointments %>
            <span class="absolute bottom-0.5 w-1 h-1 rounded-full <%= is_selected ? "bg-white" : "bg-blue-600" %>"></span>
          <% end %>
        <% end %>
      <% else %>
        <span class="mx-auto flex items-center justify-center w-8 h-8 text-gray-300"><%= date.day %></span>
      <% end %>
    <% end %>
  </div>
</div>
