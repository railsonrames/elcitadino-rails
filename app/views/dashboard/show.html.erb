<% content_for :title, t(".title") %>
<% content_for :page_title, t(".title") %>

<% content_for :page_header_identity do %>
  <div class="min-w-0">
    <div class="font-extrabold text-[15px] leading-tight truncate"><%= current_user.provider_profile.user.name %></div>
    <div class="text-[11px] text-white/75"><%= ProviderProfile.model_name.human %> · <%= current_user.provider_profile.city %></div>
  </div>
  <%= link_to edit_provider_profile_setting_path, class: "ml-auto text-white", "aria-label": t(".settings") do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[22px] h-[22px]">
      <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
    </svg>
  <% end %>
<% end %>

<% content_for :page_header_extra do %>
  <div class="flex border-t border-white/28 mt-1">
    <div class="flex-1 border-r border-white/28 px-4 py-3" data-controller="reveal" data-reveal-text-value="<%= number_to_currency(@monthly_revenue) %>">
      <div class="font-bold text-[10px] tracking-[.08em] uppercase text-white/72"><%= t(".monthly_revenue") %></div>
      <div class="flex items-center gap-2 mt-1">
        <span class="font-extrabold text-[22px] leading-none" data-reveal-target="display">••••••</span>
        <button type="button" data-action="reveal#toggle" class="text-white/80 hover:text-white" aria-label="<%= t(".toggle_revenue") %>">
          <svg data-reveal-target="showIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" /><circle cx="12" cy="12" r="3" />
          </svg>
          <svg data-reveal-target="hideIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 hidden">
            <path d="M9.9 4.24A9.75 9.75 0 0 1 12 4c7 0 11 8 11 8a17.9 17.9 0 0 1-3.24 4.36M6.5 6.6C3.4 8.5 1 12 1 12s4 8 11 8a9.8 9.8 0 0 0 5-1.4M9.9 14.1a3 3 0 1 0 4.2-4.2" /><path d="m1 1 22 22" />
          </svg>
        </button>
      </div>
    </div>
    <div class="w-[120px] shrink-0 px-4 py-3">
      <div class="font-bold text-[10px] tracking-[.08em] uppercase text-white/72"><%= t(".appointments_today") %></div>
      <div class="font-extrabold text-[22px] leading-none mt-1 text-[#6ee89b]"><%= @today_appointments_count %></div>
    </div>
  </div>
<% end %>

<div class="w-full">
  <%= turbo_frame_tag "dashboard_panel" do %>
    <%= render "calendar", calendar_month: @calendar_month, selected_date: @selected_date, appointment_dates: @appointment_dates, blocked_dates: @blocked_dates %>
    <%= render "day_agenda", selected_date: @selected_date, day_appointments: @day_appointments, blocking_time_off: @blocking_time_off %>
  <% end %>

  <div class="flex gap-3 mt-6">
    <%= link_to edit_provider_profile_path, class: "flex-1 flex items-center justify-center gap-2 rounded-[8px] border border-line bg-surface hover:bg-surface-2 px-4 py-2.5 font-bold text-sm" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
      </svg>
      <%= t(".edit_profile") %>
    <% end %>
    <%= link_to edit_provider_profile_setting_path, class: "flex-1 flex items-center justify-center gap-2 rounded-[8px] border border-line bg-surface hover:bg-surface-2 px-4 py-2.5 font-bold text-sm" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0">
        <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
      </svg>
      <%= t(".settings") %>
    <% end %>
  </div>
</div>
