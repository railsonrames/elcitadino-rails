<div>
  <h2 class="font-extrabold text-base mb-2"><%= capitalize_first(l(selected_date, format: :long)) %></h2>

  <% if blocking_time_off %>
    <div class="bg-surface border border-line rounded-[8px] p-4 flex items-center justify-between">
      <p class="text-ink-2"><%= t(".blocked") %></p>
      <%= button_to t(".unblock"), provider_profile_time_off_path(blocking_time_off), method: :delete,
            class: "rounded-[6px] border border-[#c3cad8] bg-white hover:bg-[#eef1f6] px-4 py-2 font-bold text-sm cursor-pointer" %>
    </div>
  <% else %>
    <div class="bg-surface border border-line rounded-[8px] overflow-hidden">
      <% if day_appointments.any? %>
        <% day_appointments.each do |appointment| %>
          <%= render "appointments/card", appointment: appointment, viewpoint: :provider, show_date: false %>
        <% end %>
      <% elsif selected_date >= Date.current %>
        <p class="text-ink-2 px-3.5 py-6 text-center text-sm"><%= t(".empty") %></p>
      <% else %>
        <p class="text-ink-2 px-3.5 py-6 text-center text-sm"><%= t(".empty_past") %></p>
      <% end %>

      <% if selected_date >= Date.current %>
        <div class="flex items-center gap-2.5 px-3.5 py-3 border-t border-line-2">
          <span class="font-bold text-[10px] tracking-[.06em] uppercase text-ink-3"><%= t(".block_label") %></span>

          <% if day_appointments.any? %>
            <%= render "shared/confirm_action", trigger_label: t(".block_today"),
                  path: provider_profile_time_offs_path(date: selected_date.iso8601), method: :post,
                  title: t(".block_and_reschedule"), warning: t(".confirm_block_and_reschedule"),
                  confirm_label: t(".block_today"), cancel_label: t(".keep"),
                  button_class: "rounded-[6px] border border-[#c3cad8] bg-white hover:bg-[#eef1f6] font-extrabold text-xs px-3 py-2 cursor-pointer" %>
          <% else %>
            <%= button_to t(".block_today"), provider_profile_time_offs_path(date: selected_date.iso8601), method: :post,
                  class: "rounded-[6px] border border-[#c3cad8] bg-white hover:bg-[#eef1f6] font-extrabold text-xs px-3 py-2 cursor-pointer" %>
          <% end %>

          <%= render "block_range_modal", selected_date: selected_date %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
