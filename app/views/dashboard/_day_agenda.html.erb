<div>
  <h2 class="font-bold text-lg mb-3 capitalize"><%= l(selected_date, format: :long) %></h2>

  <% if blocking_time_off %>
    <div class="border border-gray-200 rounded-2xl p-4 flex items-center justify-between">
      <p class="text-gray-500"><%= t(".blocked") %></p>
      <%= button_to t(".unblock"), provider_profile_time_off_path(blocking_time_off), method: :delete,
            class: "rounded-full px-4 py-2 bg-gray-100 hover:bg-gray-200 font-medium text-sm cursor-pointer" %>
    </div>
  <% elsif day_appointments.any? %>
    <div class="space-y-3 mb-4">
      <% day_appointments.each do |appointment| %>
        <%= render "appointments/card", appointment: appointment, viewpoint: :provider %>
      <% end %>
    </div>

    <%= render "shared/confirm_action", trigger_label: t(".block_and_reschedule"),
          path: provider_profile_time_offs_path(date: selected_date.iso8601), method: :post,
          title: t(".block_and_reschedule"), warning: t(".confirm_block_and_reschedule"),
          confirm_label: t(".block_and_reschedule"), cancel_label: t(".keep"),
          button_class: "rounded-full px-4 py-2 bg-gray-100 hover:bg-gray-200 font-medium text-sm cursor-pointer" %>
  <% elsif selected_date >= Date.current %>
    <div class="border border-gray-200 rounded-2xl p-4 flex items-center justify-between">
      <p class="text-gray-500"><%= t(".empty") %></p>
      <%= button_to t(".block"), provider_profile_time_offs_path(date: selected_date.iso8601), method: :post,
            class: "rounded-full px-4 py-2 bg-gray-100 hover:bg-gray-200 font-medium text-sm cursor-pointer" %>
    </div>
  <% else %>
    <p class="text-gray-500"><%= t(".empty_past") %></p>
  <% end %>

  <% if selected_date >= Date.current %>
    <div class="mt-3">
      <%= render "block_range_modal", selected_date: selected_date %>
    </div>
  <% end %>
</div>
