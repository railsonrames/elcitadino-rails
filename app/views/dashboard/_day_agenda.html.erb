<div>
  <h2 class="font-bold text-lg mb-3 capitalize"><%= l(selected_date, format: :long) %></h2>

  <% if blocking_time_off %>
    <div class="border border-gray-200 rounded-2xl p-4 flex items-center justify-between">
      <p class="text-gray-500"><%= t(".blocked") %></p>
      <%= button_to t(".unblock"), provider_profile_time_off_path(blocking_time_off), method: :delete,
            class: "rounded-full px-4 py-2 bg-gray-100 hover:bg-gray-200 font-medium text-sm cursor-pointer" %>
    </div>
  <% elsif day_appointments.any? %>
    <div class="space-y-3 mb-4">
      <% day_appointments.each do |appointment| %>
        <div class="border border-gray-200 rounded-2xl p-4">
          <p class="font-medium"><%= l(appointment.scheduled_at, format: :short) %> &middot; <%= appointment.client.name %></p>
          <p class="text-sm text-gray-500 mb-3"><%= appointment.service.name %> &middot; <%= t("enums.appointment.status.#{appointment.status}") %></p>

          <div class="flex flex-wrap gap-2">
            <% if appointment.pending? %>
              <%= button_to t(".confirm"), appointment_path(appointment), method: :patch, params: { appointment: { status: "confirmed" } },
                    class: "rounded-full px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm cursor-pointer" %>
            <% end %>
            <%= button_to t(".complete"), appointment_path(appointment), method: :patch, params: { appointment: { status: "completed" } },
                  class: "rounded-full px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white font-medium text-sm cursor-pointer" %>
            <%= link_to t(".reschedule"), reschedule_appointment_path(appointment),
                  class: "rounded-full px-3 py-1.5 bg-gray-100 hover:bg-gray-200 font-medium text-sm" %>
            <%= button_to t(".cancel"), appointment_path(appointment), method: :patch, params: { appointment: { status: "canceled" } },
                  data: { turbo_confirm: t(".confirm_cancel") },
                  class: "rounded-full px-3 py-1.5 bg-red-600 hover:bg-red-500 text-white font-medium text-sm cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>

    <%= button_to t(".block_and_reschedule"), provider_profile_time_offs_path(date: selected_date.iso8601), method: :post,
          data: { turbo_confirm: t(".confirm_block_and_reschedule") },
          class: "rounded-full px-4 py-2 bg-gray-100 hover:bg-gray-200 font-medium text-sm cursor-pointer" %>
  <% elsif selected_date >= Date.current %>
    <div class="border border-gray-200 rounded-2xl p-4 flex items-center justify-between">
      <p class="text-gray-500"><%= t(".empty") %></p>
      <%= button_to t(".block"), provider_profile_time_offs_path(date: selected_date.iso8601), method: :post,
            class: "rounded-full px-4 py-2 bg-gray-100 hover:bg-gray-200 font-medium text-sm cursor-pointer" %>
    </div>
  <% else %>
    <p class="text-gray-500"><%= t(".empty_past") %></p>
  <% end %>
</div>
