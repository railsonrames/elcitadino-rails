<nav class="w-full border-b border-gray-200 px-5 py-4">
  <div class="flex items-center justify-between gap-4">
    <%= link_to root_path, class: "font-bold text-xl flex items-center gap-1.5 shrink-0" do %>      
      ElCitaDino
    <% end %>

    <div class="flex items-center gap-1">
      <% if user_signed_in? %>
        <%= render "shared/notification_bell" %>
      <% end %>
      <%= render "shared/locale_switcher" %>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-end gap-4 text-sm font-medium mt-3">
    <div class="flex flex-wrap items-center gap-4">
      <% if user_signed_in? %>
        <% if current_user.client? %>
          <%= link_to t(".browse_providers"), providers_path, class: "hover:underline" %>
        <% elsif current_user.provider_profile.present? %>
          <%= link_to t(".dashboard"), dashboard_path, class: "hover:underline" %>
        <% else %>
          <%= link_to t(".complete_profile"), new_provider_profile_path, class: "hover:underline" %>
        <% end %>
        <%= link_to t(".my_appointments"), appointments_path, class: "hover:underline" %>
      <% else %>
        <%# Mobile already gets a sign-in CTA button on the right; desktop pairs this with the sign-up CTA there. %>
        <%= link_to t(".sign_in"), new_user_session_path, class: "hidden md:inline-block hover:underline" %>
      <% end %>
    </div>

    <% if user_signed_in? %>
      <%= link_to t(".account"), edit_user_registration_path, class: "hover:underline" %>
      <%= render "shared/confirm_action", trigger_label: t(".sign_out"), path: destroy_user_session_path, method: :delete,
            title: t(".sign_out"), warning: t(".confirm_sign_out"),
            confirm_label: t(".sign_out"), cancel_label: t(".stay_signed_in"),
            button_class: "hover:underline cursor-pointer font-medium" %>
    <% else %>
      <%# Mobile prioritizes sign-in (sign-up is reachable from there, styled as a CTA); desktop keeps the sign-up button as before. %>
      <%= link_to t(".sign_in"), new_user_session_path, class: "md:hidden rounded-full px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white" %>
      <%= link_to t(".sign_up"), new_user_registration_path, class: "hidden md:inline-block rounded-full px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white" %>
    <% end %>
  </div>
</nav>
