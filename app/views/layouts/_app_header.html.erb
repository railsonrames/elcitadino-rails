<%# Header azul do "app shell" (tema azul+gris) — ver docs/design/theme-azul-gris.md.
    Cada tela declara o que precisa via content_for; o header não conhece controllers. %>
<header class="bg-brand-deep text-white lg:shrink-0">
  <div class="flex items-center gap-2.5 px-4 pt-3">
    <div class="dino-placeholder w-10 h-10 shrink-0 rounded-lg border border-white/50 flex items-end justify-center pb-0.5">
      <span class="font-semibold text-[7px] font-mono text-white/90">DINO</span>
    </div>

    <% if content_for?(:page_header_identity) %>
      <%= yield :page_header_identity %>
    <% elsif user_signed_in? %>
      <span class="font-extrabold text-lg tracking-tight">ElCitaDino</span>
      <div class="ml-auto flex items-center gap-3">
        <%= render "shared/notification_bell", variant: "dark" %>
        <%= render "shared/locale_switcher", variant: "dark" %>
      </div>
    <% else %>
      <span class="font-extrabold text-lg tracking-tight">ElCitaDino</span>
      <div class="ml-auto flex items-center gap-2">
        <%= link_to t("layouts.navbar.sign_in"), new_user_session_path, class: "text-sm font-bold hover:underline" %>
        <%= link_to t("layouts.navbar.sign_up"), new_user_registration_path,
              class: "rounded-[6px] bg-white text-brand-deep font-bold text-xs px-3 py-1.5" %>
        <%= render "shared/locale_switcher", variant: "dark" %>
      </div>
    <% end %>
  </div>

  <div class="px-4 pt-4">
    <% if content_for?(:page_kicker) %>
      <div class="font-bold text-[10px] tracking-[.1em] uppercase text-white/70"><%= yield :page_kicker %></div>
    <% end %>
    <h1 class="font-extrabold text-[30px] leading-none tracking-[-0.03em] mt-1.5"><%= yield :page_title %></h1>
  </div>

  <% if content_for?(:page_header_extra) %>
    <div class="mt-3.5"><%= yield :page_header_extra %></div>
  <% end %>
</header>
