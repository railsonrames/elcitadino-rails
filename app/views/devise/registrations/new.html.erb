<div class="w-full max-w-md">
  <h1 class="font-bold text-4xl mb-6"><%= t('.sign_up') %></h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: "contents") do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="my-5">
      <%= f.label :name, class: "block font-medium mb-1" %>
      <%= f.text_field :name, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :email, class: "block font-medium mb-1" %>
      <%= f.email_field :email, autocomplete: "email", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <span class="block font-medium mb-1"><%= User.human_attribute_name(:role) %></span>
      <div class="flex gap-6 mt-2">
        <% User.roles.each_key do |role| %>
          <label class="flex items-center gap-2">
            <%= f.radio_button :role, role %>
            <%= t("enums.user.role.#{role}") %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="my-5">
      <%= f.label :password, class: "block font-medium mb-1" %>
      <% if @minimum_password_length %>
        <p class="text-sm text-gray-500"><em><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></em></p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :password_confirmation, class: "block font-medium mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= f.submit t('.sign_up'), class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
