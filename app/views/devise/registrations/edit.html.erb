<div class="w-full max-w-md">
  <%= render "shared/back_link", path: root_path, label: t('.back') %>

  <h1 class="font-bold text-4xl mb-6"><%= t('.title', resource: devise_i18n_fix_model_name_case(resource.model_name.human, i18n_key: 'registrations.edit.title')) %></h1>

  <div class="space-y-4 mb-8">
    <div>
      <p class="text-sm text-gray-500"><%= resource.class.human_attribute_name(:name) %></p>
      <p class="font-medium"><%= resource.name %></p>
    </div>
    <div>
      <p class="text-sm text-gray-500"><%= resource.class.human_attribute_name(:email) %></p>
      <p class="font-medium"><%= resource.email %></p>
    </div>
  </div>

  <div class="border-t border-gray-200">
    <%= render "shared/nav_row", path: profile_security_path, label: t('.security') %>
    <%= render "shared/nav_row", path: edit_notification_preference_path, label: t('.notifications') %>
    <% if current_user.provider? %>
      <%= render "shared/nav_row", path: edit_provider_profile_setting_path, label: t('.provider_settings') %>
    <% end %>
  </div>
</div>
