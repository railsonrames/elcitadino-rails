<div class="w-full max-w-md">
  <h1 class="font-bold text-4xl mb-6"><%= t('.sign_in') %></h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "contents") do |f| %>
    <div class="my-5">
      <%= f.label :email, class: "block font-medium mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :password, class: "block font-medium mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="my-5 flex items-center gap-2">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <div class="inline">
      <%= f.submit t('.sign_in'), class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>

  <div class="mt-8 pt-6 border-t border-gray-200 text-center">
    <p class="text-sm text-gray-500 mb-3"><%= t(".no_account_yet") %></p>
    <%= link_to t("devise.shared.links.sign_up"), new_user_registration_path,
          class: "block w-full rounded-full px-4 py-2.5 bg-blue-50 hover:bg-blue-100 text-blue-700 font-medium" %>
  </div>
</div>
