<div class="w-full max-w-md">
  <h1 class="font-bold text-4xl mb-6"><%= t('.change_your_password') %></h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }, class: "contents") do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="my-5">
      <%= f.label :password, t('.new_password'), class: "block font-medium mb-1" %>
      <% if @minimum_password_length %>
        <p class="text-sm text-gray-500"><em><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></em></p>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= f.label :password_confirmation, t('.confirm_new_password'), class: "block font-medium mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= f.submit t('.change_my_password'), class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
