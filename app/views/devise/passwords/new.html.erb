<div class="w-full max-w-md">
  <h1 class="font-bold text-4xl mb-6"><%= t('.forgot_your_password') %></h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, class: "contents") do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="my-5">
      <%= f.label :email, class: "block font-medium mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= f.submit t('.send_me_reset_password_instructions'), class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
