<div class="mt-5 space-y-1 text-sm">
  <%- if controller_name != 'sessions' %>
    <p><%= link_to t(".sign_in"), new_session_path(resource_name), class: "text-blue-600 hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= link_to t(".sign_up"), new_registration_path(resource_name), class: "text-blue-600 hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to t(".forgot_your_password"), new_password_path(resource_name), class: "text-blue-600 hover:underline" %></p>
  <% end %>
</div>
