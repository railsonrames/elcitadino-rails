<% content_for :title, t(".title") %>

<div class="w-full">
  <h1 class="font-bold text-4xl mb-6"><%= t(".title") %></h1>

  <div id="appointments" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @appointments.any? %>
      <% @appointments.each do |appointment| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render appointment %>
          <%= link_to t(".show"), appointment, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10"><%= t(".none_found") %></p>
    <% end %>
  </div>
</div>
