<%= form_with(model: appointment, url: provider_appointments_path(provider_profile), class: "contents") do |form| %>
  <% if appointment.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(appointment.errors.count, "error") %> <%= t("appointments.form.prevented_save") %></h2>

      <ul class="list-disc ml-6">
        <% appointment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :service_id %>
  <%= form.hidden_field :scheduled_at, data: { booking_target: "scheduledAt" } %>

  <div class="border border-gray-200 rounded-2xl p-4 my-5 flex justify-between items-center">
    <div>
      <p class="font-medium"><%= service.name %></p>
      <p class="text-sm text-gray-500"><%= service.duration %> min</p>
    </div>
    <p class="font-bold text-lg"><%= number_to_currency(service.price) %></p>
  </div>

  <%= form.hidden_field :modality, value: modality %>

  <% if modality == "phone" %>
    <div class="my-5">
      <%= form.label :phone_number, t("appointments.form.phone_number_label") %>
      <p class="text-sm text-gray-500 mb-2"><%= t("appointments.form.phone_number_hint") %></p>
      <%= form.telephone_field :phone_number, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :notes %>
    <%= form.textarea :notes, rows: 3, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline">
    <%= form.submit t("appointments.form.submit"), disabled: appointment.scheduled_at.blank?, data: { booking_target: "submit" },
          class: "w-full rounded-full px-3.5 py-3 bg-blue-600 hover:bg-blue-500 disabled:bg-gray-300 disabled:cursor-not-allowed text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
