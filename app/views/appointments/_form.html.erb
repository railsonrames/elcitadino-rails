<%= form_with(model: appointment, url: provider_appointments_path(provider_profile), class: "contents") do |form| %>
  <% if appointment.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(appointment.errors.count, "error") %> <%= t("appointments.form.prevented_save") %></h2>

      <ul class="list-disc ml-6">
        <% appointment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :service_id %>
  <%= form.hidden_field :scheduled_at, data: { booking_target: "scheduledAt" } %>

  <div class="border border-gray-200 rounded-2xl p-4 my-5 flex justify-between items-center">
    <div>
      <p class="font-medium"><%= service.name %></p>
      <p class="text-sm text-gray-500"><%= service.duration %> min</p>
    </div>
    <p class="font-bold text-lg"><%= number_to_currency(service.price) %></p>
  </div>

  <%= form.hidden_field :modality, value: modality %>

  <% if modality == "phone" %>
    <div class="my-5">
      <%= form.label :phone_number, t("appointments.form.phone_number_label") %>
      <p class="text-sm text-gray-500 mb-2"><%= t("appointments.form.phone_number_hint") %></p>
      <%= form.telephone_field :phone_number, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :notes %>
    <%= form.textarea :notes, rows: 3, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline">
    <% if service.requires_payment_confirmation? %>
      <div data-controller="modal" class="inline-block w-full">
        <%= button_tag t("appointments.form.submit"), type: "button",
              disabled: appointment.scheduled_at.blank?,
              data: { action: "modal#open", booking_target: "submit" },
              class: "w-full rounded-full px-3.5 py-3 bg-blue-600 hover:bg-blue-500 disabled:bg-gray-300 disabled:cursor-not-allowed text-white inline-block font-medium cursor-pointer" %>

        <dialog data-modal-target="dialog" class="rounded-2xl p-6 max-w-sm w-[90vw] m-auto backdrop:bg-black/40">
          <h3 class="font-bold text-lg mb-3"><%= t("appointments.payment_notice.title") %></h3>
          <p class="text-sm text-gray-700 mb-3"><%= t("appointments.payment_notice.warning") %></p>
          <p class="text-sm font-medium mb-1"><%= t("appointments.payment_notice.amount_label") %> <%= number_to_currency(service.deposit_amount) %></p>
          <p class="text-sm text-gray-700 whitespace-pre-line mb-5"><%= service.payment_instructions %></p>
          <div class="flex gap-2 justify-end">
            <button type="button" data-action="modal#close" class="rounded-md px-3.5 py-2 bg-gray-100 hover:bg-gray-200 font-medium cursor-pointer">
              <%= t("appointments.payment_notice.cancel") %>
            </button>
            <%= form.submit t("appointments.payment_notice.agree"), class: "rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
          </div>
        </dialog>
      </div>
    <% else %>
      <%= form.submit t("appointments.form.submit"), disabled: appointment.scheduled_at.blank?, data: { booking_target: "submit" },
            class: "w-full rounded-full px-3.5 py-3 bg-blue-600 hover:bg-blue-500 disabled:bg-gray-300 disabled:cursor-not-allowed text-white inline-block font-medium cursor-pointer" %>
    <% end %>
  </div>
<% end %>
