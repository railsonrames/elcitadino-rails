<% content_for :title, t(".title") %>

<div class="w-full max-w-md">
  <%= render "shared/back_link", path: appointments_path, label: t(".back") %>

  <%= render @appointment %>

  <div class="mt-4">
    <%= render "actions", appointment: @appointment, viewpoint: appointment_provider_view?(@appointment) ? :provider : :client %>
  </div>
</div>
