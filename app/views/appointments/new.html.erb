<% content_for :title, t(".title", provider: @provider_profile.user.name) %>

<div class="w-full max-w-md mx-auto" data-controller="booking">
  <%= render "shared/back_link", path: provider_path(city_slug: @provider_profile.city_slug, slug: @provider_profile.slug), label: t(".back") %>

  <h1 class="font-bold text-2xl mb-1"><%= t(".title", provider: @provider_profile.user.name) %></h1>
  <p class="text-gray-500 mb-6"><%= @service.name %></p>

  <%= turbo_frame_tag "booking_panel" do %>
    <% if @service.modalities.size > 1 %>
      <div class="flex gap-2 mb-4">
        <% @service.modalities.each do |modality| %>
          <%= link_to t("enums.appointment.modality.#{modality}"),
                new_provider_appointment_path(@provider_profile, service_id: @service.id, modality: modality, date: @selected_date.iso8601),
                data: { turbo_frame: "booking_panel" },
                class: "rounded-full px-4 py-1.5 text-sm font-medium #{@modality == modality ? "bg-blue-600 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200"}" %>
        <% end %>
      </div>
    <% end %>

    <% booking_date_url = ->(date) { new_provider_appointment_path(@provider_profile, service_id: @service.id, modality: @modality, date: date.iso8601) } %>
    <%= render "calendar", provider_profile: @provider_profile, service: @service, modality: @modality, calendar_month: @calendar_month, selected_date: @selected_date, date_url: booking_date_url %>
    <%= render "slots", day_schedule: @day_schedule, selected_date: @selected_date, appointment: @appointment %>
  <% end %>

  <%= render "form", appointment: @appointment, provider_profile: @provider_profile, service: @service, modality: @modality %>
</div>
