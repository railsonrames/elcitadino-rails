<% content_for :title, t(".title") %>

<div class="w-full max-w-md mx-auto" data-controller="booking">
  <%= link_to appointment_path(@appointment), class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-4" do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m15 18-6-6 6-6" /></svg>
    <%= t(".back") %>
  <% end %>

  <h1 class="font-bold text-2xl mb-1"><%= t(".title") %></h1>
  <p class="text-gray-500 mb-6"><%= @appointment.client.name %> &middot; <%= @service.name %></p>

  <% reschedule_date_url = ->(date) { reschedule_appointment_path(@appointment, date: date.iso8601) } %>

  <%= turbo_frame_tag "booking_panel" do %>
    <%= render "calendar", provider_profile: @provider_profile, service: @service, modality: @modality, calendar_month: @calendar_month, selected_date: @selected_date, date_url: reschedule_date_url %>
    <%= render "slots", day_schedule: @day_schedule, selected_date: @selected_date, appointment: @appointment %>
  <% end %>

  <%= form_with(model: @appointment, url: appointment_path(@appointment), method: :patch, class: "contents") do |form| %>
    <% if @appointment.errors.any? %>
      <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
        <ul class="list-disc ml-6">
          <% @appointment.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :scheduled_at, data: { booking_target: "scheduledAt" } %>

    <div class="inline mt-5">
      <%= form.submit t(".submit"), disabled: true, data: { booking_target: "submit" },
            class: "w-full rounded-full px-3.5 py-3 bg-blue-600 hover:bg-blue-500 disabled:bg-gray-300 disabled:cursor-not-allowed text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
