<%# locals: appointment, viewpoint: :client | :provider — rendered inside appointments/_card's
    row, both in the Citas list and (show_date: false) the Mi Agenda day agenda. %>
<% btn_solid_blue = "shrink-0 rounded-[6px] bg-brand hover:bg-brand-deep text-white font-extrabold text-xs px-3.5 py-2 cursor-pointer" %>
<% btn_solid_green = "shrink-0 rounded-[6px] bg-ok hover:bg-ok-hover text-white font-extrabold text-xs px-3.5 py-2 cursor-pointer" %>
<% btn_outline = "shrink-0 rounded-[6px] border border-[#c3cad8] bg-white hover:bg-[#eef1f6] text-ink font-extrabold text-xs px-3 py-2 cursor-pointer" %>
<% btn_text_danger = "shrink-0 rounded-[6px] bg-transparent hover:bg-[#fbeceb] text-[#b3261e] font-extrabold text-xs px-1.5 py-2 cursor-pointer" %>

<% if viewpoint == :provider %>
  <% if appointment.status.in?(%w[pending confirmed]) %>
    <% if appointment.pending? %>
      <%= button_to t("appointments.card.confirm"), appointment_path(appointment), method: :patch, params: { appointment: { status: "confirmed" } },
            class: btn_solid_green %>
    <% end %>
    <%= link_to t("appointments.card.reschedule"), reschedule_appointment_path(appointment), class: btn_outline %>
    <%# Fidelidade ao mockup: a Mi Agenda mostra só Confirmar+Reprogramar por linha, mas
        mantemos Cancelar/Completar disponíveis em toda parte — cortar uma ação existente
        é decisão de produto, não só de estilo (ver docs/design/theme-azul-gris.md). %>
    <%= render "shared/confirm_action", trigger_label: t("appointments.card.complete"),
          path: appointment_path(appointment), method: :patch, params: { appointment: { status: "completed" } },
          title: t("appointments.card.complete"), warning: t("appointments.card.confirm_complete"),
          confirm_label: t("appointments.card.complete"), cancel_label: t("appointments.card.keep"),
          confirm_button_class: "bg-ok hover:bg-ok-hover text-white", button_class: btn_solid_green %>
    <%= render "shared/confirm_action", trigger_label: t("appointments.card.cancel"),
          path: appointment_path(appointment), method: :patch, params: { appointment: { status: "canceled" } },
          title: t("appointments.card.cancel"), warning: t("appointments.card.confirm_cancel"),
          confirm_label: t("appointments.card.cancel"), cancel_label: t("appointments.card.keep"),
          button_class: btn_text_danger %>
  <% end %>
<% elsif appointment.status.in?(%w[pending confirmed]) %>
  <% if appointment.provider_profile.allow_client_reschedule? %>
    <%= link_to t("appointments.card.reschedule"), reschedule_appointment_path(appointment), class: btn_outline %>
  <% end %>
  <%= render "shared/confirm_action", trigger_label: t("appointments.card.cancel"),
        path: appointment_path(appointment), method: :patch, params: { appointment: { status: "canceled" } },
        title: t("appointments.card.cancel"), warning: t("appointments.card.confirm_cancel"),
        confirm_label: t("appointments.card.cancel"), cancel_label: t("appointments.card.keep"),
        button_class: btn_text_danger %>
<% end %>
