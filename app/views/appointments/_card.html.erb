<%# locals: appointment, viewpoint: :client | :provider, show_date: true
    Uma linha (não mais um cartão solto) — pensada pra viver dentro de um bloco branco
    único com outras linhas, separadas por border-b. Usada tanto pela lista de Citas
    quanto pela agenda do dia da Mi Agenda (show_date: false lá — o dia já está implícito
    na tela). Ver docs/design/theme-azul-gris.md. %>
<% show_date = true if !defined?(show_date) || show_date.nil? %>
<% counterparty = viewpoint == :provider ? appointment.client.name : appointment.provider_profile.user.name %>
<% tag_classes = {
     "pending" => "bg-[#fff6e6] text-[#b45309]", "confirmed" => "bg-[#e7eeff] text-[#1653d9]",
     "completed" => "bg-[#e7f4ec] text-[#15803d]", "canceled" => "bg-[#eef1f6] text-[#5b6b85]"
   }.fetch(appointment.status) %>
<% pending_payment = appointment.pending? && appointment.service.requires_payment_confirmation? %>

<div id="<%= dom_id(appointment) %>" class="flex border-b border-line-2 last:border-b-0">
  <div class="w-[66px] shrink-0 bg-surface-2 border-r border-line-2 py-[13px] text-center">
    <% if show_date %>
      <div class="font-extrabold text-[22px] leading-none"><%= l(appointment.scheduled_at, format: "%d") %></div>
      <div class="font-bold text-[10px] tracking-[.06em] uppercase text-ink-3 mt-0.5"><%= l(appointment.scheduled_at, format: "%b") %></div>
      <div class="font-extrabold text-xs text-brand mt-2"><%= l(appointment.scheduled_at, format: "%H:%M") %></div>
    <% else %>
      <div class="font-extrabold text-sm text-brand mt-[13px]"><%= l(appointment.scheduled_at, format: "%H:%M") %></div>
    <% end %>
  </div>

  <div class="flex-1 min-w-0 px-3.5 py-[13px]">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <p class="font-extrabold text-[15px] leading-tight truncate"><%= counterparty %></p>
        <p class="text-[13px] text-ink-2 mt-0.5"><%= appointment.service.name %></p>
      </div>
      <span class="shrink-0 font-extrabold text-[10px] tracking-[.03em] uppercase px-2 py-1 rounded <%= tag_classes %>">
        <%= t("enums.appointment.status.#{appointment.status}") %>
      </span>
    </div>

    <% if pending_payment %>
      <div class="mt-2.5 border-l-[3px] border-[#d97706] bg-[#fdf4e5] text-[#8a5206] px-2.5 py-2 text-xs leading-relaxed">
        <span class="font-extrabold"><%= t("appointments.payment_notice.title") %> · <%= number_to_currency(appointment.service.deposit_amount) %></span><br>
        <%= t("appointments.payment_notice.pending_note") %>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center gap-2 mt-3">
      <% if show_date %>
        <%= link_to t("appointments.card.view"), appointment,
              class: "shrink-0 rounded-[6px] bg-brand hover:bg-brand-deep text-white font-extrabold text-xs px-3.5 py-2" %>
      <% end %>
      <%= render "appointments/actions", appointment: appointment, viewpoint: viewpoint %>
    </div>
  </div>
</div>
