<% content_for :title, @provider_profile.user.name %>

<div class="w-full max-w-2xl mx-auto">
  <%= render "shared/back_link", path: providers_path, label: t(".back") %>

  <div class="flex items-start justify-between gap-4 mb-6">
    <div class="flex items-center gap-4">
      <%= render "shared/category_avatar", category: @provider_profile.category, image: @provider_profile.logo, size: "lg" %>
      <div>
        <h1 class="font-bold text-2xl"><%= @provider_profile.user.name %></h1>
        <p class="text-gray-500">
          <%= t("enums.provider_profile.category.#{@provider_profile.category}") %> &middot; <%= @provider_profile.city %>
        </p>
      </div>
    </div>
    <%= image_tag qr_code_data_uri(provider_url(@provider_profile, locale: nil)),
          alt: t(".qr_code_alt"), class: "w-16 h-16 shrink-0" %>
  </div>

  <div class="grid grid-cols-3 gap-2 mb-6 text-center">
    <div class="bg-gray-50 rounded-xl py-3 px-2">
      <p class="text-xs text-gray-500"><%= t(".badge_pricing") %></p>
    </div>
    <div class="bg-gray-50 rounded-xl py-3 px-2">
      <p class="text-xs text-gray-500"><%= t(".badge_fast_confirmation") %></p>
    </div>
    <div class="bg-gray-50 rounded-xl py-3 px-2">
      <p class="text-xs text-gray-500"><%= t(".badge_easy_cancellation") %></p>
    </div>
  </div>

  <p class="mb-8 text-gray-700"><%= @provider_profile.bio %></p>

  <h2 class="font-bold text-xl mb-4"><%= t(".services") %></h2>

  <div class="space-y-3">
    <% if @services.any? %>
      <% @services.each do |service| %>
        <div class="flex justify-between items-center border border-gray-200 rounded-2xl p-4">
          <div class="flex items-center gap-3">
            <%= render "shared/category_avatar", category: @provider_profile.category, image: service.photo, size: "sm" %>
            <div>
              <p class="font-medium"><%= service.name %></p>
              <p class="text-sm text-gray-500"><%= service.duration %> min &middot; <%= number_to_currency(service.price) %></p>
            </div>
          </div>
          <% if user_signed_in? && @provider_profile.user != current_user %>
            <%= link_to t(".book"), new_provider_appointment_path(@provider_profile, service_id: service.id),
                  class: "rounded-full px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm" %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="text-gray-500"><%= t(".no_services") %></p>
    <% end %>
  </div>

  <% unless user_signed_in? %>
    <p class="mt-6 text-sm text-gray-500">
      <%= t(".sign_in_to_book") %>
      <%= link_to t(".sign_in"), new_user_session_path, class: "text-blue-600 hover:underline" %>
    </p>
  <% end %>
</div>
