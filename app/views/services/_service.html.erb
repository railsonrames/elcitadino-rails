<div id="<%= dom_id service %>" class="flex justify-between items-center border border-gray-200 rounded-md p-4">
  <div class="flex items-center gap-3">
    <%= render "shared/category_avatar", category: service.provider_profile.category, image: service.photo, size: "sm" %>
    <div>
      <p class="font-medium"><%= service.name %></p>
      <p class="text-sm text-gray-500"><%= service.duration %> min &middot; <%= number_to_currency(service.price) %></p>
    </div>
  </div>
  <div class="flex gap-2">
    <%= link_to t("services.service.edit"), edit_provider_profile_service_path(service), class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
    <%= button_to t("services.service.destroy"), provider_profile_service_path(service), method: :delete,
          data: { turbo_confirm: t("services.service.confirm_destroy") },
          class: "rounded-md px-3 py-1.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer" %>
  </div>
</div>
