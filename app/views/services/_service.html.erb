<% destroy_icon = capture do %>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
    <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
  </svg>
<% end %>

<div id="<%= dom_id service %>" class="flex justify-between items-center border border-gray-200 rounded-md p-4">
  <div class="flex items-center gap-3">
    <%= render "shared/category_avatar", category: service.provider_profile.category, image: service.photo, size: "sm" %>
    <div>
      <p class="font-medium"><%= service.name %></p>
      <p class="text-sm text-gray-500"><%= service.duration %> min &middot; <%= number_to_currency(service.price) %></p>
    </div>
  </div>
  <div class="flex gap-2">
    <%= link_to edit_provider_profile_service_path(service),
          class: "rounded-full p-2 bg-gray-100 hover:bg-gray-200 text-gray-700",
          title: t("services.service.edit"), aria: { label: t("services.service.edit") } do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
        <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
      </svg>
    <% end %>
    <%= render "shared/confirm_action", trigger_label: t("services.service.destroy"), trigger_content: destroy_icon,
          path: provider_profile_service_path(service), method: :delete,
          title: t("services.service.destroy"), warning: t("services.service.confirm_destroy"),
          confirm_label: t("services.service.destroy"), cancel_label: t("services.service.keep"),
          button_class: "rounded-full p-2 bg-red-600 hover:bg-red-500 text-white cursor-pointer" %>
  </div>
</div>
