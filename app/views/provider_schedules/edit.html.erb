<% content_for :title, t(".title") %>

<div class="w-full max-w-md">
  <%= render "shared/back_link", path: edit_provider_profile_setting_path, label: t(".back") %>

  <h1 class="font-bold text-3xl mb-2"><%= t(".title") %></h1>
  <p class="text-sm text-gray-500 mb-6"><%= t(".help") %></p>

  <%= form_with url: provider_profile_schedule_path, method: :patch, class: "contents" do %>
    <%= render "shared/weekly_hours_grid", availabilities: @provider_profile.availabilities, field_name_prefix: "provider_profile[availability_windows]" %>

    <div class="mt-10">
      <%= submit_tag t(".submit"), class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
