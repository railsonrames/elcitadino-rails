# Segredos resolvidos pelo Kamal em runtime. NÃO colocar valores crus aqui — este arquivo
# vai para o git. Cada linha lê de uma variável de ambiente (ou de um arquivo).
#
# No CI (.github/workflows/deploy.yml) as variáveis vêm dos GitHub Secrets.
# Localmente, exporte-as antes de rodar `kamal` (ou use `kamal secrets`):
#   export RAILS_MASTER_KEY=$(cat config/master.key)
#   export ELCITADINO_DATABASE_PASSWORD=...            # mesma senha do Postgres
#   export KAMAL_REGISTRY_PASSWORD=$(gh auth token)    # token com read:packages/write:packages

# Registry (ghcr.io). No CI é o GITHUB_TOKEN efêmero do run.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Chave mestra do Rails. Usa a env se existir (CI); senão lê config/master.key (local).
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key)}

# Senha do banco: a mesma serve para o app (database.yml) e para o container Postgres.
ELCITADINO_DATABASE_PASSWORD=$ELCITADINO_DATABASE_PASSWORD
POSTGRES_PASSWORD=$ELCITADINO_DATABASE_PASSWORD
